---
// ProductCard.astro — server-rendered product card (used in the storefront
// grid). Purchasable (real) products get an Add to Cart button wired
// client-side in index.astro via data-product-id; demo products only show
// the Coming Soon badge.
interface Props {
  product: {
    id: string;
    slug: string;
    name: string;
    short_description: string | null;
    price_cents: number;
    currency: string;
    category: string | null;
    is_real: number;
  };
}

const { product } = Astro.props;
---

<article class="card group flex flex-col overflow-hidden transition-shadow hover:shadow-md">
  <a href={`/product/${product.slug}`} class="block">
    <div class="flex h-40 items-center justify-center bg-gradient-to-br from-brand-500 to-indigo-600 text-white">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-16 w-16 opacity-80">
        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
        <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
        <line x1="12" y1="22.08" x2="12" y2="12" />
      </svg>
    </div>
  </a>
  <div class="flex flex-1 flex-col gap-2 p-5">
    <div class="flex items-start justify-between gap-2">
      <a href={`/product/${product.slug}`} class="font-semibold text-gray-900 group-hover:text-brand-600">
        {product.name}
      </a>
      {!product.is_real && (
        <span class="badge shrink-0 bg-amber-100 text-amber-800" data-i18n="index.coming_soon">Segera Hadir</span>
      )}
    </div>
    {product.short_description && <p class="line-clamp-2 text-sm text-gray-600">{product.short_description}</p>}
    <div class="mt-auto flex items-center justify-between gap-2 pt-2">
      <span class="text-lg font-bold text-gray-900">
        {new Intl.NumberFormat('en-US', { style: 'currency', currency: product.currency }).format(product.price_cents / 100)}
      </span>
      {product.is_real ? (
        <button data-add-cart={product.id} class="btn-primary px-3 py-1.5" data-i18n="index.add_cart">Tambah ke Keranjang</button>
      ) : (
        <a href={`/product/${product.slug}`} class="btn-secondary px-3 py-1.5" data-i18n="index.details">Lihat Detail</a>
      )}
    </div>
  </div>
</article>
